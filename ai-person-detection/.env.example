# ai-person-detection configuration. All variables are prefixed AI_.
# Copy to .env and adjust. Values shown are the built-in defaults.

AI_SERVICE_NAME=ai-person-detection
AI_APP_ENV=development
AI_LOG_LEVEL=INFO

# --- RabbitMQ --------------------------------------------------------------
AI_RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/%2F
AI_RABBITMQ_EXCHANGE=frames
AI_INPUT_QUEUE=walking-in-no-walking-zone
AI_OUTPUT_QUEUE=walking-in-no-walking-zone-event-queue
AI_PREFETCH=4
AI_PUBLISH_CONFIRMS=true

# --- Redis (claim-check frame store) ---------------------------------------
AI_REDIS_URL=redis://redis:6379/0
AI_REDIS_ACK_COUNTER_FIELD=meta:acks_remaining

# --- Detector --------------------------------------------------------------
# yolo = Ultralytics YOLOv8n (accurate, needs torch) | hog = OpenCV (offline, lighter)
AI_DETECTOR_BACKEND=yolo
AI_MODEL_WEIGHTS=yolov8n.pt
AI_DEVICE=cpu
AI_CONFIDENCE_THRESHOLD=0.4
AI_INFERENCE_IMGSZ=640

# --- Analysis --------------------------------------------------------------
# foot = bottom-centre of bbox (best for floor zones) | center = bbox centre
AI_ROI_REFERENCE_POINT=foot

# --- Observability ---------------------------------------------------------
AI_METRICS_ENABLED=true
AI_METRICS_PORT=9106
