APP_NAME=Master Solution Backend
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql://postgres:postgres@db:5432/master_solution
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
APP_ENV=development

# MediaMTX internal service endpoints
MEDIAMTX_API_URL=http://mediamtx:9997
MEDIAMTX_PLAYBACK_API_URL=http://mediamtx:9996

# Public endpoints the frontend/browser should use
MEDIAMTX_WEBRTC_PUBLIC_URL=http://localhost:8889
MEDIAMTX_PLAYBACK_PUBLIC_URL=http://localhost:9996

# Auth0
AUTH0_DOMAIN=dev-d2x11lcqgic0sb80.us.auth0.com
# Application (Universal Login) client for "Login with Microsoft"
AUTH0_CLIENT_ID=mdYChGQzvXBmeDLpcCCfcuOG0yPhLe87
# API identifier the frontend requests the access token for (validated as `aud`)
AUTH0_AUDIENCE=https://master-solution-api

# Streaming behavior
STREAM_RECORDING_POLL_INTERVAL_MS=15000
STREAM_LIVE_EDGE_THRESHOLD_S=20
STREAM_PLAYBACK_FORMAT=fmp4
STREAM_PLAYBACK_PADDING_BEFORE_S=30
STREAM_PLAYBACK_PADDING_AFTER_S=300
STREAM_PLAYBACK_MIN_DURATION_S=60
STREAM_PLAYBACK_MAX_DURATION_S=900
