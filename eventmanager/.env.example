# Event Manager configuration. All variables are prefixed EM_.

EM_SERVICE_NAME=eventmanager
EM_APP_ENV=development
EM_LOG_LEVEL=INFO

# --- RabbitMQ --------------------------------------------------------------
EM_RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/%2F
# Comma-separated AI event queues to consume (one receiver thread each).
EM_INPUT_QUEUES=walking-in-no-walking-zone-event-queue
EM_NOTIFICATION_QUEUE=notification-queue
EM_PREFETCH=20

# --- In-memory pipeline ----------------------------------------------------
EM_QUEUE_MAXSIZE=10000
EM_ANALYSIS_WORKERS=4

# --- Redis (claim-check frame store) ---------------------------------------
EM_REDIS_URL=redis://redis:6379/0
# Must match the StreamHandler's ack counter field; the EM decrements it once
# per consumed batch so frames clear only after AI services + EM have all acked.
EM_REDIS_ACK_COUNTER_FIELD=meta:acks_remaining

# --- Database --------------------------------------------------------------
EM_DATABASE_URL=postgresql://postgres:postgres@db:5432/master_solution

# --- Event grouping (time-gap debounce) ------------------------------------
EM_EVENT_GAP_THRESHOLD_S=30

# --- Evidence video --------------------------------------------------------
EM_EVIDENCE_WIDTH=854
EM_EVIDENCE_HEIGHT=480
EM_VIDEO_FPS=1
EM_VIDEO_CRF=20
EM_DEFAULT_STREAM_QUALITY=processed
EM_TEMP_DIR=/tmp/eventmanager

# --- MinIO -----------------------------------------------------------------
EM_MINIO_ENDPOINT=minio:9000
EM_MINIO_PUBLIC_URL=http://localhost:9000
EM_MINIO_ACCESS_KEY=minioadmin
EM_MINIO_SECRET_KEY=minioadmin
EM_MINIO_BUCKET=evidence
EM_MINIO_SECURE=false

# --- Observability ---------------------------------------------------------
EM_METRICS_ENABLED=true
EM_METRICS_PORT=9107
