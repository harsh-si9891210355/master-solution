# StreamHandler configuration. All variables are prefixed SH_.
# Copy to .env and adjust. Values shown are the built-in defaults.

# --- Service ---------------------------------------------------------------
SH_SERVICE_NAME=streamhandler
SH_APP_ENV=development
SH_LOG_LEVEL=INFO

# --- Decoding --------------------------------------------------------------
# auto = prefer GStreamer, fall back to OpenCV if bindings are missing.
SH_DECODER_BACKEND=auto
SH_RTSP_TRANSPORT=tcp
SH_RTSP_LATENCY_MS=200
SH_STREAM_STALE_TIMEOUT_S=15
SH_RECONNECT_BACKOFF_BASE_S=2
SH_RECONNECT_BACKOFF_MAX_S=30

# --- Output frames (the "configurable fps / resolution" knobs) -------------
SH_TARGET_FPS=5
SH_FRAME_WIDTH=854
SH_FRAME_HEIGHT=480
SH_FRAME_KEEP_ASPECT=true
SH_JPEG_QUALITY=80

# --- Batching --------------------------------------------------------------
SH_BATCH_SIZE=10
SH_BATCH_MAX_AGE_S=5

# --- Queue transport -------------------------------------------------------
# claim_check (frames in Redis, refs in the queue) | inline (base64 in the queue)
SH_FRAME_TRANSPORT=claim_check

# --- Redis -----------------------------------------------------------------
SH_REDIS_URL=redis://redis:6379/0
SH_REDIS_KEY_PREFIX=sh
# Cleanup: refcount = delete a batch once every use-case has acked it (TTL is a
# backstop for crashed consumers) | ttl = expire purely on the TTL, no acks.
SH_REDIS_CLEANUP=refcount
# Downstream stages that consume each use-case's frames: AI service + Event
# Manager = 2. Ack counter is seeded to usecases * this. Set 1 if no Event Manager.
SH_FRAME_CONSUMERS_PER_USECASE=2
# TTL backstop. Set a bit above your worst-case consumer processing lag.
SH_REDIS_FRAME_TTL_S=300

# --- RabbitMQ --------------------------------------------------------------
SH_RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/%2F
SH_RABBITMQ_EXCHANGE=frames
SH_RABBITMQ_QUEUE_TEMPLATE={usecase_slug}
SH_RABBITMQ_PUBLISH_CONFIRMS=true
SH_RABBITMQ_PREFETCH=20

# --- Camera source ---------------------------------------------------------
# database = read from the Postgres schema (cameras + camera_usecase + usecases)
# static   = read from SH_CAMERAS_FILE instead
SH_CAMERA_SOURCE=database
SH_CAMERAS_FILE=cameras.yaml
SH_DATABASE_URL=postgresql://postgres:postgres@db:5432/master_solution
# Optional JSON ROI overlay for the database source, keyed "<camera_id>:<usecase_id>".
SH_ROI_OVERLAY_FILE=
SH_RELOAD_INTERVAL_S=30

# --- Observability ---------------------------------------------------------
SH_METRICS_ENABLED=true
SH_METRICS_PORT=9105
