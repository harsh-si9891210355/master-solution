# Notification service configuration (prefix NS_).
NS_SERVICE_NAME=notification-service
NS_APP_ENV=development
NS_LOG_LEVEL=INFO
 
# RabbitMQ — the queue the eventmanager publishes built events onto.
NS_RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/%2F
NS_NOTIFICATION_QUEUE=notification-queue
NS_PREFETCH=20
 
# Redis — pub/sub bridge to the backend WebSocket + escalation timers.
NS_REDIS_URL=redis://redis:6379/0
NS_WS_BROADCAST_CHANNEL=alerts:all
NS_WS_USER_CHANNEL_PREFIX=alerts:user:
NS_ESCALATION_ZSET=escalation:pending
NS_ESCALATION_CANCEL_CHANNEL=escalation:cancel
 
# Database — shared with the backend (alerts/deliveries/preferences live here).
NS_DATABASE_URL=postgresql://postgres:postgres@db:5432/master_solution
 
# Which role codes should receive alerts.
NS_RECIPIENT_ROLES=admin,manager
 
# Web Push (VAPID). Generate a keypair and paste it here + in the backend .env.
NS_VAPID_PUBLIC_KEY=
NS_VAPID_PRIVATE_KEY=
NS_VAPID_SUBJECT=mailto:admin@visionx.local
 
# Email (SMTP) — reuse the same mailbox as the backend.
NS_EMAIL_ENABLED=true
NS_SMTP_HOST=
NS_SMTP_PORT=587
NS_SMTP_USER=
NS_SMTP_PASSWORD=
NS_SMTP_FROM=
 
# Public base URL used in notification deep links.
NS_FRONTEND_URL=http://localhost:8080
 
# Observability.
NS_METRICS_ENABLED=true
NS_METRICS_PORT=9108