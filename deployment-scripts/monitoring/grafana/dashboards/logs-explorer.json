    {
      "type": "bargauge",
      "title": "Top services by errors (1h)",
      "id": 11,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "topk(15, sum by (compose_service) (count_over_time({compose_service=~\"$service\"} |~ \"(?i)(error|exception|traceback|critical|fatal)\" [1h])))",
          "legendFormat": "{{compose_service}}",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "instant": true,
          "queryType": "instant"
        }
      ]
    },
