APP_NAME=Master Solution Backend
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql://postgres:postgres@db:5432/master_solution
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
RESET_TOKEN_EXPIRE_MINUTES=15
APP_ENV=development

MEDIAMTX_API_URL=http://mediamtx:9997
MEDIAMTX_PLAYBACK_API_URL=http://mediamtx:9996
MEDIAMTX_WEBRTC_PUBLIC_URL=http://localhost:8889
MEDIAMTX_PLAYBACK_PUBLIC_URL=http://localhost:9996
STREAM_RECORDING_POLL_INTERVAL_MS=15000
STREAM_LIVE_EDGE_THRESHOLD_S=20
STREAM_PLAYBACK_FORMAT=fmp4
STREAM_PLAYBACK_PADDING_BEFORE_S=30
STREAM_PLAYBACK_PADDING_AFTER_S=300
STREAM_PLAYBACK_MIN_DURATION_S=60
STREAM_PLAYBACK_MAX_DURATION_S=900

# SMTP configuration for sending emails (e.g. password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Auth0
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=
AUTH0_CONNECTION=


# --- Recording transcode (store recordings at reduced quality) ---
# REC_STORE_ENABLED=false = live-only (WebRTC), do NOT record/store the feed.
REC_STORE_ENABLED=true
# REC_ENABLED=false records the live stream directly at full quality (no transcode).
REC_ENABLED=true
# If a camera has a substream URL set, record it directly (no FFmpeg). false = always transcode.
REC_PREFER_SUBSTREAM=true
# Encoder: cpu (libx264) or nvenc (NVIDIA GPU). On a GPU host set REC_ENCODER=nvenc.
REC_ENCODER=cpu
# Recording quality: target height in px (480, 360, 240…); width auto.
REC_HEIGHT=480
# Recording frame rate; 0 = keep source fps.
REC_FPS=15
# Keep only the last X hours of recordings.
REC_RETENTION_HOURS=12
# Optional fixed bitrate, e.g. 800k. Empty = encoder default quality.
REC_VIDEO_BITRATE=
# Extra ffmpeg flags appended to the transcode command (space-separated).
REC_EXTRA_FFMPEG_FLAGS=
